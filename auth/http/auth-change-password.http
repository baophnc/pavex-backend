### ==========================================
### PAVEX Auth - Change Password
### ==========================================

@baseUrl = http://localhost:8081

### Account test
@email = baofuc1205@gmail.com

### Password đang dùng hiện tại
@currentPassword = 1205@Phuc

### Password muốn đổi sang
@newPassword = ChangedPavex@123456


### ==================================================
### 1. LOGIN
### Tự lưu accessToken
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{currentPassword}}"
}

> {%
    client.global.set(
        "accessToken",
        response.body.accessToken
    );
%}


### ==================================================
### 2. CHANGE PASSWORD KHÔNG CÓ TOKEN
### PHẢI 401
### ==================================================

POST {{baseUrl}}/api/v1/auth/change-password
Content-Type: application/json

{
  "currentPassword": "{{currentPassword}}",
  "newPassword": "{{newPassword}}"
}


### ==================================================
### 3. CURRENT PASSWORD SAI
### PHẢI 400 invalid_current_password
### ==================================================

POST {{baseUrl}}/api/v1/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "WrongPassword@123456",
  "newPassword": "{{newPassword}}"
}


### ==================================================
### 4. PASSWORD MỚI GIỐNG PASSWORD CŨ
### PHẢI 400 password_unchanged
### ==================================================

POST {{baseUrl}}/api/v1/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{currentPassword}}",
  "newPassword": "{{currentPassword}}"
}


### ==================================================
### 5. CHANGE PASSWORD THÀNH CÔNG
### PHẢI 200
### ==================================================

POST {{baseUrl}}/api/v1/auth/change-password
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "currentPassword": "{{currentPassword}}",
  "newPassword": "{{newPassword}}"
}


### ==================================================
### 6. LOGIN PASSWORD CŨ
### Sau step 5 phải 401
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{currentPassword}}"
}


### ==================================================
### 7. LOGIN PASSWORD MỚI
### Sau step 5 phải 200
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{newPassword}}"
}

> {%
    client.global.set(
        "newAccessToken",
        response.body.accessToken
    );
%}


### ==================================================
### 8. ĐỔI NGƯỢC LẠI ĐỂ TEST ĐƯỢC NHIỀU LẦN
### newPassword -> currentPassword
### ==================================================

POST {{baseUrl}}/api/v1/auth/change-password
Authorization: Bearer {{newAccessToken}}
Content-Type: application/json

{
  "currentPassword": "{{newPassword}}",
  "newPassword": "{{currentPassword}}"
}
