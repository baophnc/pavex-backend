### ==========================================
### PAVEX Auth - Refresh Token Reuse
### ==========================================

@baseUrl = http://localhost:8081
@email = YOUR_EMAIL@gmail.com
@password = Pavex@123456


### 1. LOGIN -> refreshToken1
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json
User-Agent: Pavex-Reuse-Test

{
  "email": "{{email}}",
  "password": "{{password}}"
}

> {%
    client.global.set(
        "refreshToken1",
        response.body.refreshToken
    );
%}


### 2. ROTATE #1 -> #2
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json
User-Agent: Pavex-Reuse-Test

{
  "refreshToken": "{{refreshToken1}}"
}

> {%
    client.global.set(
        "refreshToken2",
        response.body.refreshToken
    );
%}


### 3. REUSE TOKEN #1
### Expected: 401 invalid_refresh_token
### Security behavior: revoke all active refresh sessions of this user.
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json
User-Agent: Pavex-Reuse-Attack

{
  "refreshToken": "{{refreshToken1}}"
}


### 4. TOKEN #2 PHẢI CHẾT SAU REUSE DETECTION
### Expected: 401 invalid_refresh_token
POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json
User-Agent: Pavex-Reuse-Test

{
  "refreshToken": "{{refreshToken2}}"
}
