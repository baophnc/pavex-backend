### ==========================================
### PAVEX Auth - Admin RBAC
### ==========================================

@baseUrl = http://localhost:8081

### Account đã được bootstrap ADMIN trong DB
@adminEmail = ADMIN_EMAIL_CUA_BAN@gmail.com
@adminPassword = Pavex@123456

### Account CUSTOMER bình thường
@customerEmail = CUSTOMER_EMAIL@gmail.com
@customerPassword = Pavex@123456


### ==================================================
### 1. LOGIN ADMIN
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set(
        "adminAccessToken",
        response.body.accessToken
    );
%}


### ==================================================
### 2. GET /ME ADMIN
### kiểm tra roles + permissions
### ==================================================

GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 3. GET ROLE CATALOG
### ADMIN -> 200
### ==================================================

GET {{baseUrl}}/api/v1/roles
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 4. LOGIN CUSTOMER
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}"
}

> {%
    client.global.set(
        "customerAccessToken",
        response.body.accessToken
    );

    client.global.set(
        "customerUserId",
        response.body.userId
    );
%}


### ==================================================
### 5. CUSTOMER GET ROLES
### PHẢI 403
### ==================================================

GET {{baseUrl}}/api/v1/roles
Authorization: Bearer {{customerAccessToken}}


### ==================================================
### 6. ADMIN ASSIGN MERCHANT CHO CUSTOMER
### PHẢI 204
### ==================================================

POST {{baseUrl}}/api/v1/users/{{customerUserId}}/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "roleCode": "MERCHANT"
}


### ==================================================
### 7. ASSIGN MERCHANT LẦN NỮA
### idempotent -> vẫn 204
### ==================================================

POST {{baseUrl}}/api/v1/users/{{customerUserId}}/roles
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "roleCode": "MERCHANT"
}


### ==================================================
### 8. LOGIN CUSTOMER LẠI
### JWT mới phải có CUSTOMER + MERCHANT
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}"
}

> {%
    client.global.set(
        "merchantAccessToken",
        response.body.accessToken
    );
%}


### ==================================================
### 9. /ME SAU ASSIGN
### ==================================================

GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{merchantAccessToken}}


### ==================================================
### 10. CUSTOMER TỰ ASSIGN ROLE
### PHẢI 403
### ==================================================

POST {{baseUrl}}/api/v1/users/{{customerUserId}}/roles
Authorization: Bearer {{customerAccessToken}}
Content-Type: application/json

{
  "roleCode": "ADMIN"
}


### ==================================================
### 11. ADMIN REMOVE MERCHANT
### PHẢI 204
### ==================================================

DELETE {{baseUrl}}/api/v1/users/{{customerUserId}}/roles/MERCHANT
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 12. REMOVE MERCHANT LẠI
### role assignment không còn
### PHẢI lỗi
### ==================================================

DELETE {{baseUrl}}/api/v1/users/{{customerUserId}}/roles/MERCHANT
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 13. ADMIN TỰ REMOVE ADMIN
### PHẢI 409 cannot_remove_own_admin_role
### ==================================================

### Thay UUID này bằng userId admin từ /me nếu cần:
@adminUserId = ADMIN_USER_ID_HERE

DELETE {{baseUrl}}/api/v1/users/{{adminUserId}}/roles/ADMIN
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 14. KHÔNG JWT GET ROLES
### PHẢI 401
### ==================================================

GET {{baseUrl}}/api/v1/roles
