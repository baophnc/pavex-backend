### ==========================================
### PAVEX Auth - Password Reset E2E
### ==========================================

@baseUrl = http://localhost:8081

### EMAIL THẬT - account phải tồn tại
@realEmail = baofuc1205@gmail.com

### Password hiện tại
@oldPassword = 1205@Phuc

### Password muốn đổi sang
@newPassword = 1205!Phuc

### Sau khi nhận Gmail, paste token vào đây
@resetToken = PJ4nZm4LrXVEE2G-JSzKa8v4Pqm_zZfmokbJYRRQQxc

### Email đúng format nhưng không tồn tại
@fakeEmail = no-account-987654321@example.com


### ==================================================
### 1. FORGOT PASSWORD - EMAIL THẬT
### ==================================================

POST {{baseUrl}}/api/v1/auth/forgot-password
Content-Type: application/json

{
  "email": "{{realEmail}}"
}


### ==================================================
### 2. FORGOT PASSWORD - EMAIL GIẢ / KHÔNG TỒN TẠI
### Anti enumeration: vẫn phải trả 200
### ==================================================

POST {{baseUrl}}/api/v1/auth/forgot-password
Content-Type: application/json

{
  "email": "{{fakeEmail}}"
}


### ==================================================
### 3. RESET PASSWORD
### Paste token nhận từ Gmail vào @resetToken phía trên
### ==================================================

POST {{baseUrl}}/api/v1/auth/reset-password
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "newPassword": "{{newPassword}}"
}


### ==================================================
### 4. REUSE TOKEN
### Sau khi request 3 thành công, chạy request này.
### Phải trả 400 invalid_password_reset_token
### ==================================================

POST {{baseUrl}}/api/v1/auth/reset-password
Content-Type: application/json

{
  "token": "{{resetToken}}",
  "newPassword": "ShouldNotWork@123456"
}


### ==================================================
### 5. LOGIN BẰNG PASSWORD CŨ
### Sau reset phải fail 401
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{realEmail}}",
  "password": "{{oldPassword}}"
}


### ==================================================
### 6. LOGIN BẰNG PASSWORD MỚI
### Phải thành công 200
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{realEmail}}",
  "password": "{{newPassword}}"
}
