### ==========================================
### PAVEX Auth - Admin Users
### ==========================================

@baseUrl = http://localhost:8081

@adminEmail = ADMIN_EMAIL@gmail.com
@adminPassword = Pavex@123456

@customerEmail = CUSTOMER_EMAIL@gmail.com
@customerPassword = Pavex@123456


### ==================================================
### 1. LOGIN ADMIN
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

> {%
    client.global.set(
        "adminAccessToken",
        response.body.accessToken
    );
%}


### ==================================================
### 2. ADMIN /ME
### ==================================================

GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{adminAccessToken}}

> {%
    const id =
        response.body.userId ??
        response.body.id;

    client.global.set(
        "adminUserId",
        id
    );
%}


### ==================================================
### 3. LOGIN CUSTOMER
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}"
}

> {%
    client.global.set(
        "customerAccessToken",
        response.body.accessToken
    );

    client.global.set(
        "customerRefreshToken",
        response.body.refreshToken
    );
%}


### ==================================================
### 4. CUSTOMER /ME
### ==================================================

GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{customerAccessToken}}

> {%
    const id =
        response.body.userId ??
        response.body.id;

    client.global.set(
        "customerUserId",
        id
    );
%}


### ==================================================
### 5. ADMIN LIST USERS
### 200
### ==================================================

GET {{baseUrl}}/api/v1/users?page=1&pageSize=20
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 6. SEARCH EMAIL
### ==================================================

GET {{baseUrl}}/api/v1/users?page=1&pageSize=20&search={{customerEmail}}
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 7. FILTER ROLE
### ==================================================

GET {{baseUrl}}/api/v1/users?page=1&pageSize=20&role=CUSTOMER
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 8. FILTER STATUS
### ==================================================

GET {{baseUrl}}/api/v1/users?page=1&pageSize=20&status=ACTIVE
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 9. FILTER PROFILE
### ==================================================

GET {{baseUrl}}/api/v1/users?page=1&pageSize=20&profileStatus=INCOMPLETE
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 10. CUSTOMER GỌI ADMIN ENDPOINT
### 403
### ==================================================

GET {{baseUrl}}/api/v1/users
Authorization: Bearer {{customerAccessToken}}


### ==================================================
### 11. USER DETAIL
### ==================================================

GET {{baseUrl}}/api/v1/users/{{customerUserId}}
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 12. UPDATE PROFILE
### 204
### ==================================================

PUT {{baseUrl}}/api/v1/users/{{customerUserId}}/profile
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "firstName": "Bao",
  "lastName": "Phuc",
  "displayName": "Bao Phuc",
  "gender": "MALE",
  "dateOfBirth": "2003-01-01",
  "avatarUrl": "https://example.com/avatar.png"
}


### ==================================================
### 13. DETAIL SAU UPDATE
### ==================================================

GET {{baseUrl}}/api/v1/users/{{customerUserId}}
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 14. DOB TƯƠNG LAI
### 400
### ==================================================

PUT {{baseUrl}}/api/v1/users/{{customerUserId}}/profile
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "firstName": "Bao",
  "lastName": "Phuc",
  "displayName": "Bao Phuc",
  "gender": "MALE",
  "dateOfBirth": "2999-01-01",
  "avatarUrl": null
}


### ==================================================
### 15. AVATAR INVALID
### 400
### ==================================================

PUT {{baseUrl}}/api/v1/users/{{customerUserId}}/profile
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "firstName": "Bao",
  "lastName": "Phuc",
  "displayName": "Bao Phuc",
  "gender": "MALE",
  "dateOfBirth": "2003-01-01",
  "avatarUrl": "abc"
}


### ==================================================
### 16. SUSPEND CUSTOMER
### 204
### ==================================================

PATCH {{baseUrl}}/api/v1/users/{{customerUserId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "status": "SUSPENDED"
}


### ==================================================
### 17. FILTER SUSPENDED
### ==================================================

GET {{baseUrl}}/api/v1/users?status=SUSPENDED
Authorization: Bearer {{adminAccessToken}}


### ==================================================
### 18. OLD REFRESH TOKEN
### PHẢI FAIL
### ==================================================

POST {{baseUrl}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{customerRefreshToken}}"
}


### ==================================================
### 19. LOGIN CUSTOMER KHI SUSPENDED
### PHẢI FAIL
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}"
}


### ==================================================
### 20. REACTIVATE CUSTOMER
### 204
### ==================================================

PATCH {{baseUrl}}/api/v1/users/{{customerUserId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "status": "ACTIVE"
}


### ==================================================
### 21. LOGIN SAU REACTIVATE
### 200
### ==================================================

POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{customerPassword}}"
}


### ==================================================
### 22. LAST ACTIVE ADMIN -> SUSPENDED
### Nếu hiện chỉ có 1 ACTIVE ADMIN
### phải 409 last_active_admin
### ==================================================

PATCH {{baseUrl}}/api/v1/users/{{adminUserId}}/status
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "status": "SUSPENDED"
}


### ==================================================
### 23. NO JWT
### 401
### ==================================================

GET {{baseUrl}}/api/v1/users
