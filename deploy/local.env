# Settings of the local stack (./pavex up). No secrets here: passwords and keys are generated into
# deploy/secrets/ on the first run. To change something for your machine only, put it in deploy/.env.local
# (not committed), for example a real SMTP server, GOOGLE_CLIENT_ID or a local checkout of a front end:
#
#   CLIENT_PORTAL_SOURCE=/Users/me/code/pavex-client-portal
#   MANAGEMENT_PORTAL_SOURCE=/Users/me/code/pavex-management-portal
#   FIELD_APP_SOURCE=/Users/me/code/pavex-warehouse
#   PAVEX_LAN_IP=192.168.1.20          # address the APK uses to reach the gateway (found automatically)

COMPOSE_PROJECT_NAME=pavex-local
COMPOSE_PROFILES=mailtest

# Required by compose.yml; the local overlay replaces every public URL with http://localhost:<port>.
PAVEX_DOMAIN=localhost
ACME_EMAIL=dev@localhost

# Ports on this machine.
GATEWAY_PORT=8080
CLIENT_PORTAL_PORT=3000
MANAGEMENT_PORTAL_PORT=3001
FIELD_APP_PORT=3002
LOCAL_POSTGRES_PORT=15432
LOCAL_RABBITMQ_UI_PORT=15672
LOCAL_MINIO_CONSOLE_PORT=9001
LOCAL_MAILPIT_PORT=8025

# First administrator admin@pavex.com; password in deploy/secrets/values/PAVEX_BOOTSTRAPADMIN_PASSWORD.
PAVEX_BOOTSTRAPADMIN_ENABLED=true
PAVEX_BOOTSTRAPADMIN_EMAIL=admin@pavex.com

# Every email goes to Mailpit (http://localhost:8025).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@pavex.local

# Fake payments: finance confirms them by hand in the management portal.
BILLING_PAYMENT_PROVIDER=fake

# Field app APK: debug (no signing key needed) or release.
FIELD_APP_APK_MODE=debug

# Image tag of the locally built backend images (staging builds use "staging").
PAVEX_TAG=local
