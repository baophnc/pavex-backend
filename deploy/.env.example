# =============================================================================
# Pavex staging trên một VPS: cấu hình của server (docs/PAVEX-TAI-LIEU-TONG-HOP.md, mục 9.7)
#
#   cp deploy/.env.example deploy/.env && chmod 600 deploy/.env    (KHÔNG commit deploy/.env)
#
# Mật khẩu DB/RabbitMQ/MinIO/Redis/Grafana, khoá Auth/Billing, khoá JWT, mật khẩu admin đầu tiên KHÔNG
# nằm ở đây: ./deploy/gen-secrets.sh sinh chúng vào deploy/secrets/. File này chỉ giữ domain, email và
# các khoá do dịch vụ bên ngoài cấp (SMTP, payOS, S3 cho bản sao lưu).
#
# Cố định trong compose.yml, không đặt ở đây: PAVEX_DEMO_RESET_ENABLED=false, Swagger/API docs tắt,
# BILLING_RECONCILIATION_ENABLED=true, bảng giá/mạng lưới demo và xe giả lập tắt,
# GATEWAY_ALLOWED_ORIGIN=https://<PAVEX_DOMAIN>, GATEWAY_TRUSTED_PROXIES=<PAVEX_SUBNET>.
#
# Viết KEY=giá-trị, không dấu ngoặc kép.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Domain và HTTPS (bắt buộc)
#    Cần 5 bản ghi DNS A (và AAAA nếu có IPv6) trỏ về IP của VPS:
#    <PAVEX_DOMAIN>, www.<PAVEX_DOMAIN>, api.<PAVEX_DOMAIN>, admin.<PAVEX_DOMAIN>, grafana.<PAVEX_DOMAIN>
# -----------------------------------------------------------------------------
PAVEX_DOMAIN=staging.example.vn
# Email nhận thông báo của Let's Encrypt (chứng chỉ sắp hết hạn...).
ACME_EMAIL=ops@example.vn
# Để trống = lấy chứng chỉ thật bằng ACME_EMAIL. "internal" = CA riêng của Caddy (chỉ để thử trên máy local).
# CADDY_TLS=internal
# Cổng công khai của Caddy (giữ 80/443 trên VPS; Let's Encrypt cần cả hai).
# HTTP_PORT=80
# HTTPS_PORT=443
# Ai được mở grafana.<domain>: danh sách IP/CIDR cách nhau bởi dấu cách. Mặc định mọi nơi (vẫn cần mật khẩu).
# GRAFANA_ALLOW_FROM=0.0.0.0/0 ::/0

# -----------------------------------------------------------------------------
# 2. Admin đầu tiên (mục 9.3)
#    Lần chạy đầu: true. Mật khẩu ở deploy/secrets/values/PAVEX_BOOTSTRAPADMIN_PASSWORD.
#    Đăng nhập admin.<domain>, đổi mật khẩu, rồi đặt lại false và chạy lại `up -d`.
# -----------------------------------------------------------------------------
PAVEX_BOOTSTRAPADMIN_ENABLED=true
PAVEX_BOOTSTRAPADMIN_EMAIL=admin@example.vn

# -----------------------------------------------------------------------------
# 3. Email thật (bắt buộc): xác thực email, quên mật khẩu, mời nhân viên, cảnh báo giám sát
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.example.vn
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.vn
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
MAIL_FROM=no-reply@example.vn

# -----------------------------------------------------------------------------
# 4. Đăng nhập Google (tuỳ chọn). Thêm https://<PAVEX_DOMAIN> vào "Authorized JavaScript origins".
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# 5. Thanh toán (mục 9.5). fake = QR giả; payos = tiền thật.
#    Webhook đăng ký trong trang payOS: https://api.<PAVEX_DOMAIN>/api/v1/integrations/payos/webhook
# -----------------------------------------------------------------------------
BILLING_PAYMENT_PROVIDER=fake
# PAYOS_ENABLED=true
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=

# -----------------------------------------------------------------------------
# 6. Sao lưu PostgreSQL và MinIO (mục 9.7.6). Mặc định 02:30 mỗi đêm, giữ 7 bản ngày + 4 bản tuần trong
#    deploy/backups/.
# -----------------------------------------------------------------------------
# BACKUP_SCHEDULE=30 2 * * *
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_DIR=./backups
# Bản sao ra ngoài server (S3, Cloudflare R2, Backblaze B2, MinIO...): điền BUCKET là bật.
# BACKUP_S3_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
# BACKUP_S3_REGION=ap-southeast-1
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=pavex-staging
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# Nhà cung cấp theo tên của rclone (AWS, Cloudflare, Minio, Other...).
# BACKUP_S3_PROVIDER=Other
# Xoá bản trên S3 cũ hơn mức này.
# BACKUP_S3_KEEP=35d

# -----------------------------------------------------------------------------
# 7. Giám sát (mục 9.7.7)
# -----------------------------------------------------------------------------
# Email nhận cảnh báo (service chết, nhiều lỗi 5xx, đĩa sắp đầy, sao lưu quá cũ), qua SMTP ở mục 3.
# Để trống thì cảnh báo chỉ hiện trong Prometheus/Alertmanager.
# ALERT_EMAIL_TO=ops@example.vn
# PROMETHEUS_RETENTION=15d
# Cổng trên loopback của VPS cho các trang quản trị (mở bằng SSH tunnel).
# OPS_RABBITMQ_PORT=15672
# OPS_MINIO_PORT=9001
# OPS_PROMETHEUS_PORT=9090
# OPS_ALERTMANAGER_PORT=9093

# -----------------------------------------------------------------------------
# 8. Image và tài nguyên
# -----------------------------------------------------------------------------
# Backend: build trên server (`up -d --build`) hoặc kéo từ registry: <PAVEX_IMAGE_PREFIX>/<service>:<PAVEX_TAG>.
# PAVEX_IMAGE_PREFIX=pavex
# PAVEX_TAG=staging
# Hai portal: image build từ repo của chúng (mục 9.7.2).
# CLIENT_PORTAL_IMAGE=pavex/client-portal:staging
# MANAGEMENT_PORTAL_IMAGE=pavex/management-portal:staging
# Mạng nội bộ của các container; đổi nếu trùng với mạng có sẵn trên server.
# PAVEX_SUBNET=172.30.0.0/24
# RAM tối đa mỗi service Java (heap = 75%) và cờ JVM.
# JAVA_MEM_LIMIT=640m
# JAVA_TOOL_OPTIONS=-XX:+UseSerialGC -Xss512k
# MinIO: tên đăng nhập gốc (mật khẩu ở deploy/secrets/values/MINIO_SECRET_KEY).
# MINIO_ACCESS_KEY=pavex
# Múi giờ của lịch sao lưu.
# TZ=Asia/Ho_Chi_Minh
