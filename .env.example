# =============================================================================
# Pavex backend: cấu hình riêng của máy bạn
#
#   cp .env.example .env      (rồi sửa .env; KHÔNG commit .env, file này đã nằm trong .gitignore)
#
# Mọi service tự đọc file .env ở thư mục gốc này, dù chạy bằng ./scripts/dev-up.sh hay bằng IntelliJ.
# Mật khẩu DB/RabbitMQ/MinIO, khoá, admin local... không có giá trị mặc định trong application.yaml
# (để bản deploy thật quên biến nào thì dừng ngay). ./scripts/dev-up.sh tự thêm giá trị local của chúng
# vào cuối .env (tạo .env nếu chưa có); chỉ chạy bằng IntelliJ thì chạy một lần: bash scripts/local-env.sh
# Mật khẩu admin@pavex.com ở local: PAVEX_BOOTSTRAPADMIN_PASSWORD trong .env (sinh ngẫu nhiên, sửa được).
# Ngoài các giá trị đó, không cần thêm gì để chạy local:
#   - email vào Mailpit: http://localhost:8025
#   - thanh toán dùng cổng "fake" (tài chính bấm xác nhận thay cho ngân hàng)
#   - đăng nhập Google tắt
#
# Quy tắc viết:
#   - Mỗi dòng KEY=giá-trị, không dùng dấu ngoặc kép, không để trống (KEY=).
#     Muốn dùng mặc định thì giữ dấu # ở đầu dòng.
#   - Biến export sẵn trong terminal được ưu tiên hơn file này,
#     ví dụ: BILLING_PAYMENT_PROVIDER=fake ./scripts/dev-up.sh
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Đăng nhập Google (client portal, cổng 3000)
#    Tạo OAuth Client "Web application" trong Google Cloud Console, thêm
#    http://localhost:3000 và http://localhost vào "Authorized JavaScript origins".
#    Dùng CÙNG giá trị cho GOOGLE_CLIENT_ID trong .env.local của client portal.
#    Xem docs/CHAY-LOCAL.md, mục "Đăng nhập Google".
# -----------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com


# -----------------------------------------------------------------------------
# 2. Email (xác thực email, quên mật khẩu, mời nhân viên, xác nhận yêu cầu hỗ trợ)
#    Mặc định email vào Mailpit (http://localhost:8025), không ra hộp thư thật.
#    Muốn gửi thật qua Gmail: bật xác minh 2 bước, tạo App Password 16 ký tự,
#    rồi bỏ dấu # ở cả khối dưới và điền vào.
# -----------------------------------------------------------------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=ban@gmail.com
# MAIL_PASSWORD=app-password-16-ky-tu
# MAIL_FROM=ban@gmail.com


# -----------------------------------------------------------------------------
# 3. Thanh toán (Billing)
#    fake  = QR giả, tài chính bấm "Xác nhận thanh toán (giả lập)" trong trang Hoá đơn. Mặc định.
#    payos = tiền thật qua payOS; lấy khoá trong trang quản lý payOS (kênh thanh toán).
#    Ở local payOS không gọi webhook vào localhost được: bật BILLING_RECONCILIATION_ENABLED=true
#    để Billing tự hỏi lại trạng thái. Thời lượng viết kiểu ISO-8601: PT15S = 15 giây, PT2M = 2 phút.
# -----------------------------------------------------------------------------
# BILLING_PAYMENT_PROVIDER=payos
# PAYOS_ENABLED=true
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# BILLING_RECONCILIATION_ENABLED=true
# BILLING_RECONCILIATION_INTERVAL=PT2M


# -----------------------------------------------------------------------------
# 4. Lưu ảnh và tệp (MinIO). Mặc định khớp compose.yml; trang quản trị: http://localhost:9001
#    (đăng nhập pavex / pavex-minio). Chỉ đổi khi dùng MinIO/S3 ở nơi khác.
# -----------------------------------------------------------------------------
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=pavex
# MINIO_SECRET_KEY=pavex-minio


# -----------------------------------------------------------------------------
# 5. Link trong email trỏ về portal (chỉ đổi khi portal không chạy ở localhost)
# -----------------------------------------------------------------------------
# EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
# PASSWORD_RESET_URL=http://localhost:3000/reset-password
# MANAGEMENT_PASSWORD_RESET_URL=http://localhost:3001/reset-password
# INVITATION_URL=http://localhost:3000/accept-invite
# MANAGEMENT_INVITATION_URL=http://localhost:3001/accept-invite


# -----------------------------------------------------------------------------
# 6. Chế độ test
# -----------------------------------------------------------------------------
# Ca cả ngày: mọi nhân sự có ca 00:00–24:00 mỗi ngày, không ngày nghỉ, nên vào ca và
# nhận việc được bất cứ giờ nào. Mặc định tắt (ca theo luân phiên 6 ngày làm, 1 ngày nghỉ).
# OPERATIONS_SHIFT_FULL_DAY=true
# Người đang trong ca được tự chuyển sang ca hôm sau khi qua 00:00; kiểm tra mỗi 5 phút thay vì mỗi giờ.
# OPERATIONS_SHIFT_ROSTER_INTERVAL=PT5M
# Việc giao tự động mà không ai bấm nhận trong thời gian này sẽ được giao lại (mặc định 15 phút).
# OPERATIONS_ACCEPT_TIMEOUT=PT12H
# Xe giả lập: xe trung chuyển đang chạy mà không có điện thoại gửi vị trí sẽ tự chạy dọc tuyến
# (60 km/h = 10 km mỗi 10 phút), để xem bản đồ và thử luồng tới nơi mà không cần ai lái xe.
# FLEET_SIMULATOR_ENABLED=true
# Tăng tốc khi test, ví dụ 600 km/h:
# FLEET_SIMULATOR_SPEED_KMH=60
# Nút "Đặt lại dữ liệu thử" của quản trị (Hệ thống → Giả lập): xoá mọi vận đơn, việc, chỗ giữ tuyến, báo giá,
# chuyến xe/GPS, tiền và thông báo để chạy thử lại từ đầu. Tài khoản, cửa hàng, mạng lưới, bảng giá, ca làm giữ nguyên.
# PAVEX_DEMO_RESET_ENABLED=true


# -----------------------------------------------------------------------------
# 7. Deploy thật: KHÔNG dùng file này hay .env của máy local.
#    Danh sách biến bắt buộc: docs/PAVEX-TAI-LIEU-TONG-HOP.md, mục "Triển khai thật".
#    Các giá trị local do scripts/local-env.sh thêm vào .env (mật khẩu "pavex", khoá local, admin local,
#    STAFF_TEMPORARY_PASSWORD=123456, Swagger bật, bảng giá demo) không bao giờ được dùng ở môi trường thật.
# -----------------------------------------------------------------------------
