# Pavex backend — cấu hình cho các chức năng thật (email, payOS, Google).
#
# Cách dùng: cp .env.example .env, điền giá trị, rồi chạy ./scripts/dev-up.sh (script tự nạp .env).
# Biến nào để trống (KEY=) hoặc không có thì service dùng mặc định local trong application.yaml:
# email vào Mailpit (http://localhost:8025), thanh toán dùng cổng "fake".
# Biến đã export sẵn trong shell được ưu tiên hơn file .env.
# Không commit file .env thật (đã có trong .gitignore).

# ---------------------------------------------------------------------------
# Email (Auth: xác thực email, quên mật khẩu, mời nhân viên; Partners: xác nhận yêu cầu hỗ trợ)
# Gmail: bật xác minh 2 bước rồi tạo App Password 16 ký tự, không dùng mật khẩu Gmail thường.
# Chạy thật nên dùng SES/SendGrid/Mailgun với domain riêng có SPF/DKIM; các biến vẫn như dưới.
# Để nguyên các dòng có dấu # thì email đi vào Mailpit; bỏ dấu # và điền để gửi email thật.
# ---------------------------------------------------------------------------
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SMTP_AUTH=true
# MAIL_STARTTLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=

# Link trong email trỏ về portal (đổi sang domain thật khi deploy)
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password
MANAGEMENT_PASSWORD_RESET_URL=http://localhost:3001/reset-password
INVITATION_URL=http://localhost:3000/accept-invite

# ---------------------------------------------------------------------------
# Đăng nhập Google — phải trùng GOOGLE_CLIENT_ID trong .env.local của client portal.
# Google Cloud Console: thêm domain client portal vào "Authorized JavaScript origins".
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------------------
# Thanh toán payOS (Billing). "fake" = QR giả, admin bấm xác nhận; "payos" = tiền thật.
# Khoá lấy trong trang quản lý payOS (kênh thanh toán). Webhook cần đăng ký tại payOS:
#   https://<domain gateway>/api/v1/integrations/payos/webhook
# Ở local payOS không gọi được localhost: dùng tunnel (ngrok, cloudflared) hoặc để
# BILLING_RECONCILIATION_ENABLED=true cho Billing tự hỏi lại trạng thái thanh toán.
# Thời lượng viết theo ISO-8601: PT15S = 15 giây, PT2M = 2 phút.
# ---------------------------------------------------------------------------
BILLING_PAYMENT_PROVIDER=fake
PAYOS_ENABLED=false
PAYOS_API_BASE_URL=https://api-merchant.payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/account/billing
PAYOS_CANCEL_URL=http://localhost:3000/account/billing
PAYOS_TIMEOUT=PT15S
BILLING_RECONCILIATION_ENABLED=false
BILLING_RECONCILIATION_INTERVAL=PT2M
BILLING_RECONCILIATION_MINIMUM_AGE=PT30S
BILLING_RECONCILIATION_BATCH_SIZE=50

# ---------------------------------------------------------------------------
# Chỉ cần khi deploy thật (để trống ở local)
# ---------------------------------------------------------------------------
# Tài khoản admin khởi tạo: mật khẩu trong YAML chỉ dành cho local. Đổi, hoặc tắt sau khi đã có admin thật.
# PAVEX_BOOTSTRAPADMIN_PASSWORD=
# PAVEX_BOOTSTRAPADMIN_ENABLED=false
# Mật khẩu tạm cho tài khoản quản trị viên tạo (bắt đổi ở lần đăng nhập đầu) và thời gian còn dùng được
# STAFF_TEMPORARY_PASSWORD=
# STAFF_TEMPORARY_PASSWORD_TTL=PT72H
# Thư mục khoá JWT sinh riêng cho môi trường thật (scripts/security-bootstrap.sh)
# PAVEX_KEYSDIR=
# Địa chỉ công khai của gateway, origin được phép gọi, và IP các server Next.js được tin
# (xem docs/PAVEX-TAI-LIEU-TONG-HOP.md, mục 2.3.7)
# PAVEX_PUBLIC_BASE_URL=
# GATEWAY_ALLOWED_ORIGIN=
# GATEWAY_TRUSTED_PROXIES=
# Tắt bảng giá demo tự tạo
# PRICING_DEMO_SEED_ENABLED=false
# Database, RabbitMQ, Redis: <SERVICE>_DB_URL / _DB_USERNAME / _DB_PASSWORD (AUTH dùng DB_URL...),
# RABBITMQ_HOST / _PORT / _USERNAME / _PASSWORD, REDIS_HOST / _PORT
